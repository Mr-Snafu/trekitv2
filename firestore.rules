rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // users/{uid}
    //   uid: string (required, immutable, <= 128)
    //   email: string (required, private PII, <= 254)
    //   displayName: string (optional for legacy users, 1-80)
    //   bio: string (optional, 0-240)
    //   notifyCircleRequests: bool (optional, defaults true)
    //   notifyAdventureActivity: bool (optional, defaults true)
    //   allowCircleRequests: bool (optional, defaults true)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)
    //
    // trips/{tripId}/snippets/{snippetId}
    //   text: string (required, 1-1000)
    //   location: string (optional, 1-160)
    //   authorId: string (required, immutable, <= 128)
    //   capturedAt: timestamp (required, immutable, never future-dated)
    //
    // circleProfiles/{uid}
    //   userId: string (required, immutable)
    //   trekId: string (required, immutable, server-generated)
    //   displayName: string (required, server-sourced, 1-80)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)
    //
    // trekIds/{trekId}
    //   userId: string (required, immutable)
    //   createdAt: timestamp (required, immutable)
    //
    // users/{uid}/{circle|incomingRequests|outgoingRequests|blocked}/{otherUid}
    //   userId: string (required, immutable, the other user)
    //   trekId: string (required, immutable)
    //   displayName: string (required, 1-80)
    //   status: string (optional: connected, pending, cooldown)
    //   createdAt: timestamp (required, immutable)
    //   retryAfter: timestamp (optional)
    // All Circle documents are written only by authenticated Cloud Functions.
    //
    // users/{uid}/notifications/{notificationId}
    //   type: string (required, immutable, enum)
    //   title: string (required, immutable, 1-80)
    //   body: string (required, immutable, 1-240)
    //   tripId: string (optional, immutable, <= 128)
    //   createdAt: timestamp (required, immutable)
    //   readAt: timestamp (optional, the only client-editable field)
    // Notifications are created only by trusted Cloud Functions.
    //
    // trips/{tripId}
    //   name: string (required, 1-100)
    //   description: string (required, 0-1000)
    //   location: string (optional, 1-160)
    //   startDate: timestamp (optional)
    //   endDate: timestamp (optional, not before startDate when both exist)
    //   status: string (optional for legacy trips: draft, live, completed)
    //   coverImagePath: string (optional, owner-scoped Storage path)
    //   ownerId: string (required, immutable, <= 128)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)
    //
    // trips/{tripId}/members/{uid}
    //   userId: string (required, immutable, equals document ID)
    //   role: string (required: owner, editor, or viewer)
    //   createdBy: string (required, immutable, <= 128)
    //   createdAt: timestamp (required, immutable)
    //
    // trips/{tripId}/entries/{entryId}
    //   title: string (required, 1-120)
    //   body: string (required, 1-10000)
    //   authorId: string (required, immutable, <= 128)
    //   imagePath: string (optional, immutable uploader-scoped Storage path)
    //   memoryDate: timestamp (optional for legacy entries, never future-dated)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)
    //
    // trips/{tripId}/comments/{commentId}
    //   entryId: string (required, immutable, <= 128)
    //   body: string (required, 1-2000)
    //   authorId: string (required, immutable, <= 128)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isRecent(value) {
      return value is timestamp &&
        value >= request.time - duration.value(5, 'm') &&
        value <= request.time + duration.value(1, 'm');
    }

    function isValidEmail(value) {
      return value is string &&
        value.size() > 3 &&
        value.size() <= 254 &&
        value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidUser(data) {
      return hasRequiredFields(
          data, ['uid', 'email', 'createdAt', 'updatedAt']) &&
        hasOnlyAllowedFields(
          data, [
            'uid', 'email', 'displayName', 'bio', 'notifyCircleRequests',
            'notifyAdventureActivity', 'allowCircleRequests', 'createdAt',
            'updatedAt'
          ]) &&
        isValidId(data.uid) &&
        isValidEmail(data.email) &&
        (!('displayName' in data) ||
          (data.displayName is string &&
            data.displayName.size() > 0 &&
            data.displayName.size() <= 80)) &&
        (!('bio' in data) ||
          (data.bio is string && data.bio.size() <= 240)) &&
        (!('notifyCircleRequests' in data) ||
          data.notifyCircleRequests is bool) &&
        (!('notifyAdventureActivity' in data) ||
          data.notifyAdventureActivity is bool) &&
        (!('allowCircleRequests' in data) ||
          data.allowCircleRequests is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return hasRequiredFields(data, ['type', 'title', 'body', 'createdAt']) &&
        hasOnlyAllowedFields(data, [
          'type', 'title', 'body', 'tripId', 'createdAt', 'readAt'
        ]) &&
        data.type is string &&
        data.type in [
          'circleRequest', 'adventureEntry', 'adventureComment',
          'quickSnippet', 'adventureShared'
        ] &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.body is string &&
        data.body.size() > 0 &&
        data.body.size() <= 240 &&
        (!('tripId' in data) || isValidId(data.tripId)) &&
        data.createdAt is timestamp &&
        (!('readAt' in data) || data.readAt is timestamp);
    }

    function isValidTripCoverPath(data, tripId) {
      return !('coverImagePath' in data) ||
        (data.coverImagePath is string &&
          data.coverImagePath.size() > 0 &&
          data.coverImagePath.size() <= 512 &&
          data.coverImagePath == 'users/' + data.ownerId + '/trips/' +
            tripId + '/cover');
    }

    function isValidTrip(data, tripId) {
      return hasRequiredFields(data, [
          'name', 'description', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        hasOnlyAllowedFields(data, [
          'name', 'description', 'location', 'startDate', 'endDate',
          'status', 'coverImagePath', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.description is string &&
        data.description.size() <= 1000 &&
        (!('location' in data) ||
          (data.location is string &&
            data.location.size() > 0 &&
            data.location.size() <= 160)) &&
        (!('startDate' in data) || data.startDate is timestamp) &&
        (!('endDate' in data) || data.endDate is timestamp) &&
        (!(('startDate' in data) && ('endDate' in data)) ||
          data.endDate >= data.startDate) &&
        (!('status' in data) ||
          (data.status is string &&
            data.status in ['draft', 'live', 'completed'])) &&
        isValidId(data.ownerId) &&
        isValidTripCoverPath(data, tripId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMember(data) {
      return hasRequiredFields(
          data, ['userId', 'role', 'createdBy', 'createdAt']) &&
        hasOnlyAllowedFields(
          data, ['userId', 'role', 'createdBy', 'createdAt']) &&
        isValidId(data.userId) &&
        data.role is string &&
        data.role in ['owner', 'editor', 'viewer'] &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp;
    }

    function isValidEntryImagePath(data, tripId, entryId) {
      return !('imagePath' in data) ||
        (data.imagePath is string &&
          data.imagePath.size() > 0 &&
          data.imagePath.size() <= 512 &&
          data.imagePath == 'users/' + data.authorId + '/trips/' + tripId +
            '/entries/' + entryId + '/photo');
    }

    function isValidEntry(data, tripId, entryId) {
      return hasRequiredFields(
          data, ['title', 'body', 'authorId', 'createdAt', 'updatedAt']) &&
        hasOnlyAllowedFields(
          data, [
            'title', 'body', 'authorId', 'createdAt', 'updatedAt', 'imagePath',
            'memoryDate'
          ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 120 &&
        data.body is string &&
        data.body.size() > 0 &&
        data.body.size() <= 10000 &&
        isValidId(data.authorId) &&
        isValidEntryImagePath(data, tripId, entryId) &&
        (!('memoryDate' in data) ||
          (data.memoryDate is timestamp && data.memoryDate <= request.time)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function entryIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'authorId', 'createdAt', 'imagePath'
      ]);
    }

    function isValidComment(data) {
      return hasRequiredFields(data, [
          'entryId', 'body', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        hasOnlyAllowedFields(data, [
          'entryId', 'body', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.entryId) &&
        data.body is string &&
        data.body.size() > 0 &&
        data.body.size() <= 2000 &&
        isValidId(data.authorId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function commentIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'entryId', 'authorId', 'createdAt'
      ]);
    }

    function isValidSnippet(data) {
      return hasRequiredFields(data, [
          'text', 'authorId', 'capturedAt'
        ]) &&
        hasOnlyAllowedFields(data, [
          'text', 'location', 'authorId', 'capturedAt'
        ]) &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() <= 1000 &&
        (!('location' in data) ||
          (data.location is string &&
            data.location.size() > 0 &&
            data.location.size() <= 160)) &&
        isValidId(data.authorId) &&
        data.capturedAt is timestamp &&
        data.capturedAt <= request.time + duration.value(1, 'm');
    }

    function snippetUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'text', 'location', 'authorId', 'capturedAt'
      ]);
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function memberPath(tripId, userId) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(userId);
    }

    function entryPath(tripId, entryId) {
      return /databases/$(database)/documents/trips/$(tripId)/entries/$(entryId);
    }

    function tripExists(tripId) {
      return exists(tripPath(tripId));
    }

    function isTripOwner(tripId) {
      return isAuthenticated() &&
        tripExists(tripId) &&
        get(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function isTripOwnerAfter(tripId) {
      return isAuthenticated() &&
        getAfter(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function isTripMember(tripId) {
      return isAuthenticated() &&
        tripExists(tripId) &&
        (get(tripPath(tripId)).data.ownerId == request.auth.uid ||
          exists(memberPath(tripId, request.auth.uid)));
    }

    function canEditTrip(tripId) {
      return isAuthenticated() &&
        tripExists(tripId) &&
        (get(tripPath(tripId)).data.ownerId == request.auth.uid ||
          (exists(memberPath(tripId, request.auth.uid)) &&
            get(memberPath(tripId, request.auth.uid)).data.role in [
              'owner', 'editor'
            ]));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        request.resource.data.uid == userId &&
        isValidUser(request.resource.data) &&
        isRecent(request.resource.data.createdAt) &&
        isRecent(request.resource.data.updatedAt);

      allow update: if isOwner(userId) &&
        uidNotModified() &&
        request.resource.data.uid == userId &&
        isValidUser(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isRecent(request.resource.data.updatedAt);

      allow delete: if isOwner(userId);

      match /circle/{otherUserId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /incomingRequests/{otherUserId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /outgoingRequests/{otherUserId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /blocked/{otherUserId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId) &&
          isValidNotification(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']) &&
          'readAt' in request.resource.data &&
          isRecent(request.resource.data.readAt);
        allow delete: if isOwner(userId);
      }
    }

    // Identity lookup and uniqueness reservations are server-only so TrekIt
    // does not expose a searchable public profile directory.
    match /circleProfiles/{userId} {
      allow read, write: if false;
    }

    match /trekIds/{trekId} {
      allow read, write: if false;
    }

    // Enables a signed-in user to discover only their own membership records
    // across trips. The client query must include userId == request.auth.uid.
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid ||
          exists(memberPath(tripId, request.auth.uid)));

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        'status' in request.resource.data &&
        isValidTrip(request.resource.data, tripId) &&
        isRecent(request.resource.data.createdAt) &&
        isRecent(request.resource.data.updatedAt);

      allow update: if isTripOwner(tripId) &&
        isValidTrip(request.resource.data, tripId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isRecent(request.resource.data.updatedAt);

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isTripMember(tripId);

        allow create: if isAuthenticated() &&
          isValidMember(request.resource.data) &&
          request.resource.data.userId == memberId &&
          request.resource.data.createdBy == request.auth.uid &&
          isRecent(request.resource.data.createdAt) &&
          isTripOwnerAfter(tripId) &&
          ((memberId == request.auth.uid &&
              request.resource.data.role == 'owner') ||
            (memberId != request.auth.uid &&
              request.resource.data.role in ['editor', 'viewer']));

        allow update: if isTripOwner(tripId) &&
          memberId != request.auth.uid &&
          isValidMember(request.resource.data) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.role in ['editor', 'viewer'];

        allow delete: if isTripOwner(tripId) &&
          memberId != request.auth.uid;
      }

      match /entries/{entryId} {
        allow read: if isTripMember(tripId);

        allow create: if canEditTrip(tripId) &&
          request.resource.data.authorId == request.auth.uid &&
          isValidEntry(request.resource.data, tripId, entryId) &&
          isRecent(request.resource.data.createdAt) &&
          isRecent(request.resource.data.updatedAt);

        allow update: if isTripMember(tripId) &&
          (resource.data.authorId == request.auth.uid ||
            isTripOwner(tripId)) &&
          isValidEntry(request.resource.data, tripId, entryId) &&
          entryIdentityUnchanged() &&
          isRecent(request.resource.data.updatedAt);

        // Server-side deletion also removes related comments and any photo.
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow read: if isTripMember(tripId);

        allow create: if isTripMember(tripId) &&
          request.resource.data.authorId == request.auth.uid &&
          isValidComment(request.resource.data) &&
          exists(entryPath(tripId, request.resource.data.entryId)) &&
          isRecent(request.resource.data.createdAt) &&
          isRecent(request.resource.data.updatedAt);

        allow update: if isTripMember(tripId) &&
          resource.data.authorId == request.auth.uid &&
          isValidComment(request.resource.data) &&
          commentIdentityUnchanged() &&
          exists(entryPath(tripId, request.resource.data.entryId)) &&
          isRecent(request.resource.data.updatedAt);

        allow delete: if isTripMember(tripId) &&
          (resource.data.authorId == request.auth.uid ||
            isTripOwner(tripId));
      }

      match /snippets/{snippetId} {
        allow read: if isTripMember(tripId);

        allow create: if canEditTrip(tripId) &&
          request.resource.data.authorId == request.auth.uid &&
          isValidSnippet(request.resource.data);

        // Identical retry writes are allowed so an offline queue can safely
        // retry without producing duplicates or changing posted content.
        allow update: if isTripMember(tripId) &&
          resource.data.authorId == request.auth.uid &&
          isValidSnippet(request.resource.data) &&
          snippetUnchanged();

        allow delete: if isTripMember(tripId) &&
          (resource.data.authorId == request.auth.uid ||
            isTripOwner(tripId));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isValidPhotoUpload(userId, tripId, entryId) {
      return isOwner(userId) &&
        isValidId(tripId) &&
        isValidId(entryId) &&
        request.resource.size > 0 &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/.*');
    }

    // One private photo per entry. The UID path prevents cross-user access.
    match /users/{userId}/trips/{tripId}/entries/{entryId}/photo {
      allow get: if isOwner(userId);
      allow create, update: if isValidPhotoUpload(userId, tripId, entryId);
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
